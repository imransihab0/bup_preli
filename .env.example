# --- Required: OpenAI API credentials ----------------------------------------
# Create at https://platform.openai.com/api-keys
# NEVER commit the real value. On Render, set this in the service's Environment tab.
OPENAI_API_KEY=

# --- Optional: model + tuning (defaults shown) -------------------------------
# Model used to interpret operator_notes.
#   gpt-5.6-luna   -> cheapest and fastest, default (keeps p95 latency low)
#   gpt-5.6-terra  -> balanced, if paraphrase accuracy needs headroom
#   gpt-5.6-sol    -> flagship of the 5.6 family
GRIDWISE_MODEL=gpt-5.6-luna

# Reasoning effort for the interpretation call. This is short extraction work,
# so low keeps latency down. Set to an empty value to omit the parameter.
#   none | minimal | low | medium | high | xhigh | max
GRIDWISE_REASONING_EFFORT=low

# Seconds allowed for a single LLM call before the deterministic fallback runs.
GRIDWISE_LLM_TIMEOUT=12

# SDK-level retry count for transient 429/5xx responses.
GRIDWISE_LLM_MAX_RETRIES=1

# Set to "1" to skip the LLM entirely and use the deterministic fallback parser.
# Offline/local testing only - this does NOT satisfy the challenge LLM requirement.
GRIDWISE_DISABLE_LLM=0

# Port the service binds to. Render injects this automatically.
PORT=8000
